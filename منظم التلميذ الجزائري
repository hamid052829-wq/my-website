<body>

<header>
    <h1>📚 منظم التلميذ الجزائري</h1>
    <div class="creator">
        من صنع تلميذ متوسطة 19 ماي 1956 🇩🇿
    </div>
    <div class="clock" id="clock">الساعة الآن: 12:31:12</div>
</header>

<div class="container">

<!-- المواد -->
<div class="card">
    <h2>📖 المواد الدراسية</h2>

    <div id="subjects"><div class="subject">
            <input value="الرياضيات">
            <button class="danger">
                حذف
            </button>
        </div><div class="subject">
            <input value="اللغة العربية">
            <button class="danger">
                حذف
            </button>
        </div><div class="subject">
            <input value="الفرنسية">
            <button class="danger">
                حذف
            </button>
        </div><div class="subject">
            <input value="الإنجليزية">
            <button class="danger">
                حذف
            </button>
        </div><div class="subject">
            <input value="العلوم الطبيعية">
            <button class="danger">
                حذف
            </button>
        </div><div class="subject">
            <input value="الفيزياء">
            <button class="danger">
                حذف
            </button>
        </div><div class="subject">
            <input value="التاريخ والجغرافيا">
            <button class="danger">
                حذف
            </button>
        </div><div class="subject">
            <input value="التربية الإسلامية">
            <button class="danger">
                حذف
            </button>
        </div></div>

    <button class="secondary">
        ➕ إضافة مادة
    </button>
</div>

<!-- البرنامج الأسبوعي -->
<div class="card">
    <h2>🗓️ برنامج الأسبوع</h2>

    <label>اختر اليوم</label>

    <div class="days">
        <button class="dayBtn">الأحد</button>
        <button class="dayBtn">الإثنين</button>
        <button class="dayBtn">الثلاثاء</button>
        <button class="dayBtn">الأربعاء</button>
        <button class="dayBtn">الخميس</button>
        <button class="dayBtn">الجمعة</button>
        <button class="dayBtn">السبت</button>
    </div>

    <br>

    <label>المادة</label>
    <select id="subjectSelect"><option value="الرياضيات">الرياضيات</option><option value="اللغة العربية">اللغة العربية</option><option value="الفرنسية">الفرنسية</option><option value="الإنجليزية">الإنجليزية</option><option value="العلوم الطبيعية">العلوم الطبيعية</option><option value="الفيزياء">الفيزياء</option><option value="التاريخ والجغرافيا">التاريخ والجغرافيا</option><option value="التربية الإسلامية">التربية الإسلامية</option></select>

    <label>وقت البداية</label>
    <input type="time" id="startTime">

    <label>وقت النهاية</label>
    <input type="time" id="endTime">

    <label>نوع المهمة</label>
    <select id="taskType">
        <option>مراجعة الدرس</option>
        <option>حل تمارين</option>
        <option>حفظ</option>
        <option>قراءة</option>
        <option>تحضير للغد</option>
        <option>اختبار قصير</option>
    </select>

    <button class="primary">
        ➕ إضافة إلى البرنامج
    </button>
</div>

<!-- إنشاء برنامج يومي -->
<div class="card">
    <h2>⭐ برنامجي اليومي</h2>

    <p>
        التطبيق يرتب لك المهام حسب الوقت ويعرض لك ما يجب فعله اليوم.
    </p>

    <button class="primary">
        🚀 إنشاء برنامج اليوم
    </button>

    <div id="todaySchedule"><div class="empty">
                لا توجد مهام مضافة لهذا اليوم.
                <br>
                أضف برنامجك من قسم برنامج الأسبوع.
            </div></div>

    <div class="progressBox">
        <div class="progress" id="progress" style="width: 0%;"></div>
    </div>

    <p id="progressText" class="small">التقدم: 0%</p>
</div>

<!-- إضافة مهمة سريعة -->
<div class="card">
    <h2>➕ مهمة سريعة</h2>

    <label>المهمة</label>
    <input id="quickTask" placeholder="مثلا: مراجعة الرياضيات">

    <label>الوقت</label>
    <input type="time" id="quickTime">

    <button class="primary">
        إضافة المهمة
    </button>
</div>

<!-- المنبه -->
<div class="card">
    <h2>⏰ المنبه</h2>

    <p>
        عند وصول وقت إحدى المهام، سيظهر تنبيه داخل التطبيق ويحاول الهاتف تشغيل صوت التنبيه.
    </p>

    <button class="secondary">
        🔔 تفعيل المنبه
    </button>

    <p id="alarmStatus" class="small">
        المنبه غير مفعل
    </p>
</div>

<!-- حفظ -->
<div class="card">
    <h2>💾 البيانات</h2>

    <button class="secondary">
        💾 حفظ البرنامج
    </button>

    <button class="danger">
        🗑️ حذف كل البيانات
    </button>
</div>

</div>

<div id="notification"></div>




</body></html>
