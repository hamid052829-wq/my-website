.time { font-size: 20px; font-weight: bold; color: rgb(8, 127, 91); }

.empty { text-align: center; color: rgb(119, 119, 119); padding: 20px; }

.progressBox { background: rgb(238, 238, 238); height: 18px; border-radius: 20px; overflow: hidden; margin-top: 10px; }

.progress { height: 100%; width: 0%; background: rgb(8, 127, 91); transition: 0.3s; }

